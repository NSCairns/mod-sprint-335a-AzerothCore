[worldserver]

#
#    Mod Sprinting Configuration
#

#
#    Sprint.MaxStamina
#        Description: Maximum global stamina pool for all players.
#        Default:     100.0
#

Sprint.MaxStamina = 100.0

#
#    Sprint.SpeedMultiplier
#        Description: Movement speed multiplier while sprinting (1.0 = normal, 1.5 = 50% faster).
#        Default:     1.5
#

Sprint.SpeedMultiplier = 1.5
